{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Cloud profile and saved game progression for a signed-in Dudu & Tata player.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the player.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "playerCode": {
          "type": "string",
          "description": "Permanent unique 6-digit player ID for mabar invites.",
          "minLength": 6,
          "maxLength": 6,
          "pattern": "^[0-9]{6}$"
        },
        "displayName": {
          "type": "string",
          "description": "Player display name shown in profile and mabar invites.",
          "minLength": 1,
          "maxLength": 40
        },
        "photoURL": {
          "type": "string",
          "description": "Optional profile avatar URL.",
          "maxLength": 512
        },
        "tataBest": {
          "type": "integer",
          "description": "Highest solo score with Tata."
        },
        "duduBest": {
          "type": "integer",
          "description": "Highest solo score with Dudu."
        },
        "bestCombo": {
          "type": "integer",
          "description": "Highest combo streak achieved."
        },
        "totalPoints": {
          "type": "integer",
          "description": "Redeemable point balance."
        },
        "rupiahBalance": {
          "type": "integer",
          "description": "In-game Rupiah balance for shop purchases."
        },
        "exchangeCount": {
          "type": "integer",
          "description": "Total point-to-Rupiah redemptions completed."
        },
        "ownedItems": {
          "type": "array",
          "description": "Purchased shop item IDs."
        },
        "equippedByChar": {
          "type": "object",
          "description": "Equipped hat, glasses, shirt, and costume IDs for dudu and tata."
        },
        "equippedCarpet": {
          "type": "string",
          "description": "Active patterned carpet ID.",
          "maxLength": 40
        },
        "boosterCounts": {
          "type": "object",
          "description": "Stock counts for boost_speed and boost_time2x."
        },
        "armedBoosters": {
          "type": "object",
          "description": "Whether speedBoost and time2xBoost are armed for next round."
        },
        "friends": {
          "type": "array",
          "description": "Saved mabar friends (up to 30) added via 6-digit playerCode for quick invites."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when cloud profile was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when cloud profile was last updated."
        }
      },
      "required": [
        "uid",
        "playerCode",
        "displayName",
        "photoURL",
        "tataBest",
        "duduBest",
        "bestCombo",
        "totalPoints",
        "rupiahBalance",
        "exchangeCount",
        "ownedItems",
        "equippedByChar",
        "equippedCarpet",
        "boosterCounts",
        "armedBoosters",
        "friends",
        "createdAt",
        "updatedAt"
      ]
    },
    "PlayerDirectoryEntry": {
      "title": "PlayerDirectoryEntry",
      "description": "Public non-PII mabar card keyed by 6-digit playerCode.",
      "type": "object",
      "properties": {
        "playerCode": {
          "type": "string",
          "description": "Unique 6-digit player ID.",
          "minLength": 6,
          "maxLength": 6,
          "pattern": "^[0-9]{6}$"
        },
        "uid": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Player display name.",
          "minLength": 1,
          "maxLength": 40
        },
        "photoURL": {
          "type": "string",
          "description": "Optional avatar URL.",
          "maxLength": 512
        },
        "preferredChar": {
          "type": "string",
          "enum": ["dudu", "tata"],
          "description": "Currently selected character."
        },
        "duduBest": {
          "type": "integer",
          "description": "Highest Dudu score."
        },
        "tataBest": {
          "type": "integer",
          "description": "Highest Tata score."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest update."
        }
      },
      "required": [
        "playerCode",
        "uid",
        "displayName",
        "photoURL",
        "preferredChar",
        "duduBest",
        "tataBest",
        "updatedAt"
      ]
    },
    "TurnMatch": {
      "title": "TurnMatch",
      "description": "Direct-invite online turn-based 2-player duel with live 3D spectator state.",
      "type": "object",
      "properties": {
        "matchId": {
          "type": "string",
          "description": "Unique match ID.",
          "minLength": 6,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "durationSec": {
          "type": "integer",
          "description": "Round duration in seconds (45, 60, or 90)."
        },
        "status": {
          "type": "string",
          "enum": ["invited", "player1_turn", "player2_turn", "finished", "declined"],
          "description": "Turn-based invite & live match lifecycle status."
        },
        "player1Uid": {
          "type": "string",
          "description": "Inviter Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "player1Code": {
          "type": "string",
          "description": "Inviter 6-digit playerCode.",
          "minLength": 6,
          "maxLength": 6,
          "pattern": "^[0-9]{6}$"
        },
        "player1Name": {
          "type": "string",
          "description": "Inviter display name.",
          "minLength": 1,
          "maxLength": 40
        },
        "player1Char": {
          "type": "string",
          "enum": ["dudu", "tata"],
          "description": "Character selected by Player 1."
        },
        "player1Photo": {
          "type": "string",
          "description": "Inviter avatar URL.",
          "maxLength": 512
        },
        "player2Uid": {
          "type": "string",
          "description": "Invited player Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "player2Code": {
          "type": "string",
          "description": "Invited player 6-digit playerCode.",
          "minLength": 6,
          "maxLength": 6,
          "pattern": "^[0-9]{6}$"
        },
        "player2Name": {
          "type": "string",
          "description": "Invited player display name.",
          "minLength": 1,
          "maxLength": 40
        },
        "player2Char": {
          "type": "string",
          "enum": ["dudu", "tata"],
          "description": "Character selected by Player 2."
        },
        "player2Photo": {
          "type": "string",
          "description": "Invited player avatar URL.",
          "maxLength": 512
        },
        "liveState": {
          "type": "object",
          "description": "Real-time position, falling items, and live HUD snapshot of the active turn player."
        },
        "player1Result": {
          "type": "object",
          "description": "Final turn score summary for Player 1."
        },
        "player2Result": {
          "type": "object",
          "description": "Final turn score summary for Player 2."
        },
        "winnerUid": {
          "type": "string",
          "description": "Winning player UID or 'draw'.",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when invite was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest update."
        }
      },
      "required": [
        "matchId",
        "durationSec",
        "status",
        "player1Uid",
        "player1Code",
        "player1Name",
        "player1Char",
        "player1Photo",
        "player2Uid",
        "player2Code",
        "player2Name",
        "player2Char",
        "player2Photo",
        "liveState",
        "player1Result",
        "player2Result",
        "winnerUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "LiveStreamFrame": {
      "title": "LiveStreamFrame",
      "description": "High-frequency real-time spectator snapshot stored in /matches/{matchId}/live/state without parent document contention.",
      "type": "object",
      "properties": {
        "turnUid": {
          "type": "string",
          "description": "Firebase Auth UID of the active turn player.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "charId": {
          "type": "string",
          "enum": ["dudu", "tata"],
          "description": "Active character in the 3D arena."
        },
        "x": {
          "type": "number",
          "description": "Horizontal arena position."
        },
        "y": {
          "type": "number",
          "description": "Vertical jump position."
        },
        "vx": {
          "type": "number",
          "description": "Horizontal velocity."
        },
        "vy": {
          "type": "number",
          "description": "Vertical jump velocity."
        },
        "score": {
          "type": "integer",
          "description": "Live round score."
        },
        "timeLeft": {
          "type": "integer",
          "description": "Seconds remaining in current turn."
        },
        "lives": {
          "type": "integer",
          "description": "Remaining lives (0-3)."
        },
        "combo": {
          "type": "integer",
          "description": "Current combo count."
        },
        "maxCombo": {
          "type": "integer",
          "description": "Best combo in current turn."
        },
        "itemsCaught": {
          "type": "integer",
          "description": "Items caught in current turn."
        },
        "feverActive": {
          "type": "boolean",
          "description": "Whether Fever Mode is active."
        },
        "seq": {
          "type": "integer",
          "description": "Monotonic event sequence counter."
        },
        "eventLabel": {
          "type": "string",
          "description": "Latest catch or hazard label.",
          "maxLength": 40
        },
        "items": {
          "type": "array",
          "description": "Bounded list (max 14) of active falling items."
        }
      },
      "required": [
        "turnUid",
        "charId",
        "x",
        "y",
        "vx",
        "vy",
        "score",
        "timeLeft",
        "lives",
        "combo",
        "maxCombo",
        "itemsCaught",
        "feverActive",
        "seq",
        "eventLabel",
        "items"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private player profile and cloud save progression owned by userId."
    },
    "/playerDirectory/{playerCode}": {
      "schema": { "$ref": "#/entities/PlayerDirectoryEntry" },
      "description": "Non-PII mabar player directory keyed by unique 6-digit playerCode."
    },
    "/matches/{matchId}": {
      "schema": { "$ref": "#/entities/TurnMatch" },
      "description": "Direct-invite turn-based multiplayer match lifecycle and turn results."
    },
    "/matches/{matchId}/live/{liveDocId}": {
      "schema": { "$ref": "#/entities/LiveStreamFrame" },
      "description": "Dedicated real-time 3D spectator stream document (liveDocId == 'state')."
    }
  }
}
